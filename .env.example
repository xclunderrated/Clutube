# GEMINI_API_KEY: Required for Gemini AI API calls.
# This is a placeholder key.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# IMPORTANT: Uncomment the line below if your app uses the Gemini API.
# If left commented out, the key will NOT be packaged in the APK.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# TMDB API key for the catalog (movies/series metadata, artwork, trailers).
# The default below is a public read-only key so fresh clones build and run.
# The maintainer can override it in a local (gitignored) .env file with:
# TMDB_API_KEY=paste_your_key_here
# Get a free key at https://www.themoviedb.org/settings/api (v3 auth).
TMDB_API_KEY=1c94c7cf6636d243e6e3eafbbe690d4d

# Subtitle providers for offline CC downloads (all optional).
# "UNSET" (the default) means no embedded key ships in the APK. The
# maintainer can set real keys in a local (gitignored) .env file; end users
# can alternatively paste their own keys in the app's subtitle settings
# (BYOK), which take precedence over these embedded values.
# See SettingsManager subtitle keys.
# Get a free Wyzie key at https://store.wyzie.io/redeem (1,000 req/day).
WYZIE_API_KEY=UNSET
# Get a free SubDL key at https://subdl.com/panel/api (2,000 req/day).
SUBDL_API_KEY=UNSET
